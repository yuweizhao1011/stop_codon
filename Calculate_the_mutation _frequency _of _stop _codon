#定义输入和输出文件路径
input_file="./stop_codon/stopcodon_rate.txt"
output_file="./stop_codon/stopcodon_rate_clean.txt"

# 检查输入文件是否存在
if [ ! -f "$input_file" ]; then
    echo "错误：输入文件不存在 - $input_file"
    exit 1
fi

# 提取第一行和最后三行
first_line=$(head -n 1 "$input_file")
last_three_lines=$(tail -n 3 "$input_file")

# 将第一行和最后三行组合
combined_lines="$first_line
$last_three_lines"

# 转置数据，使用制表符作为分隔符
transposed=$(echo "$combined_lines" | awk -F '\t' '{
    for (i = 1; i <= NF; i++) {
        a[NR, i] = $i
    }
    max_col = (NF > max_col ? NF : max_col)
}
END {
    for (i = 1; i <= max_col; i++) {
        for (j = 1; j <= NR; j++) {
            printf "%s", a[j, i]
            if (j < NR) {
                printf "\t"
            }
        }
        print ""
    }
}')

# 保存转置后的数据到输出文件
echo "$transposed" > "$output_file"

echo "成功生成文件：$output_file"

